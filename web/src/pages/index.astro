---
const title = "Math Drill Web";
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="A browser-based mental arithmetic trainer." /><title>{title}</title></head>
  <body>
    <main>
      <p class="eyebrow">Math Drill</p><h1>Practice arithmetic. Find the patterns.</h1><p class="intro">A focused timed drill that keeps your session history in this browser.</p>
      <section id="setup" aria-labelledby="setup-title"><h2 id="setup-title">Start a drill</h2><form id="setup-form"><label>Session name <input id="session-name" value="practice" maxlength="120" /></label><label>Duration <select id="duration"><option value="30">30 seconds</option><option value="60" selected>1 minute</option><option value="120">2 minutes</option><option value="300">5 minutes</option></select></label><fieldset><legend>Operations</legend><label><input type="checkbox" name="operation" value="add" checked /> Add</label><label><input type="checkbox" name="operation" value="sub" checked /> Subtract</label><label><input type="checkbox" name="operation" value="mul" checked /> Multiply</label><label><input type="checkbox" name="operation" value="div" /> Divide</label></fieldset><label class="check"><input id="allow-negative" type="checkbox" checked /> Allow negative subtraction answers</label><button type="submit">Start drill</button><p id="setup-error" class="error" role="alert"></p></form></section>
      <section id="drill" hidden aria-labelledby="drill-title"><div class="drill-bar"><span>Time <strong id="timer">0:00</strong></span><span>Score <strong id="score">0</strong></span></div><h2 id="drill-title">What is <span id="question">…</span>?</h2><form id="answer-form"><label class="answer-label">Your answer <input id="answer" inputmode="numeric" autocomplete="off" /></label><button type="submit">Submit answer</button></form><p id="drill-status" role="status" aria-live="polite"></p></section>
      <section id="results" hidden aria-labelledby="results-title"><h2 id="results-title">Drill complete</h2><p id="results-summary"></p><p id="save-status" role="status"></p><button id="restart" type="button">Start another drill</button></section>
      <section id="analytics" aria-labelledby="analytics-title"><h2 id="analytics-title">Your insights</h2><label>View history <select id="analytics-session"><option value="">All sessions</option></select></label><p id="analytics-empty" class="muted">Complete a drill to see timing and accuracy patterns.</p><div id="analytics-content" hidden><div class="metric-grid" id="summary-metrics"></div><div class="analytics-grid"><article><h3>Digit difficulty</h3><div id="digit-view"></div></article><article><h3>Average response time</h3><div id="operation-view"></div></article><article><h3>Response sequence</h3><div id="sequence-view"></div></article></div></div><p id="analytics-error" class="error" role="alert"></p></section>
      <section id="import" aria-labelledby="import-title"><h2 id="import-title">Import desktop history</h2><p class="muted">Choose a Math Drill JSON export. The file is validated before it is added to this browser.</p><label>JSON file <input id="import-file" type="file" accept="application/json,.json" /></label><p id="import-status" role="status" aria-live="polite"></p></section>
    </main>
  </body>
</html>
<script>
  import { createDrillConfig, ConfigError } from "../lib/core";
  import { DrillController } from "../lib/drill";
  import { appendBrowserSession } from "../lib/storage";
  import { importBrowserSessions, loadBrowserSessions } from "../lib/storage";
  import { computeInsightFlags, digitDifficulty, flattenSessions, responseTimeSeries, sessionSummary, type FeatureRow } from "../lib/features";
  const $ = (id: string) => document.getElementById(id)!; const setup = $("setup"), drill = $("drill"), results = $("results"); const form = $("setup-form") as HTMLFormElement, answerForm = $("answer-form") as HTMLFormElement; let controller: DrillController | null = null; let interval = 0;
  const show = (section: HTMLElement) => { setup.hidden = section !== setup; drill.hidden = section !== drill; results.hidden = section !== results; };
  const finishView = () => { if (!controller) return; clearInterval(interval); const s = controller.state, total = s.records.length, accuracy = total ? Math.round((s.score / total) * 100) : 0; $("results-summary").textContent = `${s.score} of ${total} correct (${accuracy}%).`; $("save-status").textContent = s.saveError ? `Could not save this session: ${s.saveError}` : "Session saved in this browser."; show(results); renderAnalytics(); ($("restart") as HTMLButtonElement).focus(); };
  const render = () => { if (!controller) return; controller.tick(); const s = controller.state; $("timer").textContent = s.deadline === null ? "0:00" : `${Math.max(0, Math.ceil((s.deadline - performance.now()) / 1000))}s`; $("score").textContent = String(s.score); if (s.currentQuestion) $("question").textContent = s.currentQuestion.text; if (s.status === "finished") finishView(); };
  form.addEventListener("submit", (event) => { event.preventDefault(); $("setup-error").textContent = ""; try { const operations = [...document.querySelectorAll<HTMLInputElement>('input[name="operation"]:checked')].map((input) => input.value); const config = createDrillConfig({ sessionName: ($("session-name") as HTMLInputElement).value, duration: Number(($ ("duration") as HTMLSelectElement).value), operations, allowNegativeAnswers: ($("allow-negative") as HTMLInputElement).checked }); controller = new DrillController(config, { save: (session) => appendBrowserSession(session) }); controller.start(); show(drill); render(); requestAnimationFrame(() => { controller?.armQuestion(); ($("answer") as HTMLInputElement).focus(); render(); }); interval = window.setInterval(render, 100); } catch (error) { $("setup-error").textContent = error instanceof ConfigError ? error.message : "Drill settings could not be used."; } });
  answerForm.addEventListener("submit", (event) => { event.preventDefault(); if (!controller) return; const input = $("answer") as HTMLInputElement; const result = controller.submit(input.value); if (result === "ignored") { $("drill-status").textContent = input.value.trim() ? "Enter a number." : "Type an answer first."; return; } input.value = ""; render(); if (controller.state.status === "running") requestAnimationFrame(() => { controller?.armQuestion(); input.focus(); }); });
  $("restart").addEventListener("click", () => { clearInterval(interval); controller = null; show(setup); ($("session-name") as HTMLInputElement).focus(); });
  const renderAnalytics = () => { const empty = $("analytics-empty"), content = $("analytics-content"), error = $("analytics-error"), selector = $("analytics-session") as HTMLSelectElement; try { const sessions = loadBrowserSessions(), names = [...new Set(sessions.map((s) => s.sessionName))], current = selector.value; selector.innerHTML = '<option value="">All sessions</option>' + names.map((name) => `<option value="${name.replaceAll('"', '&quot;')}">${name}</option>`).join(''); selector.value = names.includes(current) ? current : ''; const rows = flattenSessions(sessions); if (!rows.length) { empty.hidden = false; content.hidden = true; return; } const selected = selector.value ? rows.filter((r) => r.sessionName === selector.value) : rows; const flagged = computeInsightFlags(selected), summary = sessionSummary(flagged); empty.hidden = true; content.hidden = false; error.textContent = ''; $("summary-metrics").innerHTML = `<span><b>${summary.total}</b> answered</span><span><b>${Math.round(summary.accuracy * 100)}%</b> accuracy</span><span><b>${summary.avgTimeSec.toFixed(1)}s</b> average</span><span><b>${summary.questionsPerMin.toFixed(1)}</b> questions/min</span>`; const digits = digitDifficulty(flagged, 1); $("digit-view").innerHTML = digits.length ? `<table><thead><tr><th>Digit</th><th>Avg time</th><th>Error rate</th><th>n</th></tr></thead><tbody>${digits.map((d) => `<tr><td>${d.digit}</td><td>${d.avgTime.toFixed(1)}s</td><td>${Math.round(d.errorRate * 100)}%</td><td>${d.n}</td></tr>`).join('')}</tbody></table>` : '<p class="muted">Not enough digit samples yet.</p>'; const byOp = new Map<string, FeatureRow[]>(); flagged.forEach((r) => byOp.set(r.operation, [...(byOp.get(r.operation) ?? []), r])); $("operation-view").innerHTML = `<table><thead><tr><th>Operation</th><th>Avg time</th><th>n</th></tr></thead><tbody>${[...byOp].map(([op, group]) => `<tr><td>${op}</td><td>${(group.reduce((sum, r) => sum + r.timeTakenSec, 0) / group.length).toFixed(1)}s</td><td>${group.length}</td></tr>`).join('')}</tbody></table>`; const sequence = responseTimeSeries(flagged); $("sequence-view").innerHTML = `<table><thead><tr><th>#</th><th>Time</th><th>Rolling</th></tr></thead><tbody>${sequence.slice(-10).map((r) => `<tr><td>${r.questionNumber}</td><td>${r.timeTakenSec.toFixed(1)}s</td><td>${r.rolling.toFixed(1)}s</td></tr>`).join('')}</tbody></table>`; } catch (e) { empty.hidden = true; content.hidden = true; error.textContent = e instanceof Error ? e.message : "Insights could not be loaded."; } };
  $("analytics-session").addEventListener("change", renderAnalytics); renderAnalytics();
  $("import-file").addEventListener("change", async (event) => { const input = event.currentTarget as HTMLInputElement, file = input.files?.[0]; if (!file) return; const status = $("import-status"); try { const text = await file.text(); const sessions = importBrowserSessions(text); status.textContent = `Imported ${sessions.length} session${sessions.length === 1 ? "" : "s"}.`; renderAnalytics(); } catch (error) { status.textContent = error instanceof Error ? `Import failed: ${error.message}` : "Import failed. No history was changed."; } input.value = ""; });
</script>
<style>
  :global(*) { box-sizing: border-box; } :global(body) { margin: 0; min-width: 320px; background: #f5f1e8; color: #1f2a24; font-family: system-ui, sans-serif; } main { max-width: 760px; margin: 0 auto; padding: 10vh 24px; } .eyebrow { color: #66765e; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; } h1 { max-width: 12ch; margin: 16px 0; font-size: clamp(2.8rem, 8vw, 5.6rem); line-height: .95; } h2 { margin-top: 42px; } h3 { margin-bottom: 8px; } .intro { max-width: 58ch; color: #526056; font-size: 1.15rem; line-height: 1.6; } form { display: grid; gap: 18px; max-width: 430px; } label { display: grid; gap: 6px; font-weight: 650; } input, select, button { font: inherit; padding: 10px 12px; border: 1px solid #aeb7aa; border-radius: 6px; background: #fffaf0; } button { width: fit-content; cursor: pointer; background: #1f2a24; color: #fffaf0; border-color: #1f2a24; font-weight: 700; } fieldset { display: flex; flex-wrap: wrap; gap: 10px 18px; border: 1px solid #c7cfc3; padding: 14px; } fieldset label, .check { display: flex; align-items: center; gap: 7px; font-weight: 500; } fieldset input, .check input { width: 1rem; } .error { min-height: 1.3em; color: #a33f2c; } .muted { color: #66765e; } .drill-bar { display: flex; justify-content: space-between; max-width: 430px; padding: 14px 0; border-bottom: 1px solid #c7cfc3; } #drill-title { font-size: clamp(2rem, 7vw, 4rem); } .answer-label input { font-size: 1.5rem; } #results-summary { font-size: 1.3rem; } .metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 18px 0; } .metric-grid span, article { padding: 14px; background: #fffaf0; border: 1px solid #d9dfd5; } .metric-grid b { display: block; font-size: 1.3rem; } .analytics-grid { display: grid; gap: 14px; } #import-file { margin-top: 6px; } table { width: 100%; border-collapse: collapse; } th, td { padding: 7px 4px; text-align: left; border-bottom: 1px solid #d9dfd5; } @media (max-width: 560px) { .metric-grid { grid-template-columns: repeat(2, 1fr); } } [hidden] { display: none !important; }
</style>
