---
import "../styles/app.css";
const ranges = [
  ["add1", "Addition / subtraction: first operand", 2, 100],
  ["add2", "Addition / subtraction: second operand", 2, 100],
  ["mul1", "Multiplication: first operand / division quotient", 2, 12],
  ["mul2", "Multiplication: second operand / division divisor", 2, 100],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Practise mental arithmetic and understand the number patterns that take you time."
    />
    <title>Math Drill</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">Math Drill</p>
        <h1>
          Practice arithmetic.
          <br />
          Find the patterns.
        </h1>
        <p class="intro">
          Short, focused drills. Clear insights into your speed and accuracy.
          Your history stays in this browser.
        </p>
      </header>
      <noscript>
        This drill needs JavaScript. Enable it in your browser to practise.
      </noscript>
      <section id="setup" aria-labelledby="setup-title">
        <h2 id="setup-title">Start a drill</h2>
        <form id="setup-form">
          <div class="setup-grid">
            <label>
              Session name{" "}
              <input id="session-name" value="practice" maxlength="120" />
            </label>
            <label>
              Duration
              <select id="duration">
                <option value="30">30 seconds</option>
                <option value="60" selected>
                  1 minute
                </option>
                <option value="120">2 minutes</option>
                <option value="300">5 minutes</option>
              </select>
            </label>
          </div>
          <fieldset class="operations">
            <legend>Operations</legend>
            <label>
              <input type="checkbox" name="operation" value="add" checked />{" "}
              Addition
            </label>
            <label>
              <input type="checkbox" name="operation" value="sub" checked />{" "}
              Subtraction
            </label>
            <label>
              <input type="checkbox" name="operation" value="mul" checked />{" "}
              Multiplication
            </label>
            <label>
              <input type="checkbox" name="operation" value="div" /> Division
            </label>
          </fieldset>
          <label class="check">
            <input id="allow-negative" type="checkbox" checked /> Allow negative
            subtraction answers
          </label>
          <details>
            <summary>Operand ranges</summary>
            <p class="muted">
              Division is always exact. Its dividend is the divisor × quotient.
              Operand order may swap for other operations.
            </p>
            {ranges.map(([id, label, min, max]) => (
              <fieldset class="range">
                <legend>{label}</legend>
                <label>
                  Minimum{" "}
                  <input
                    id={id + "-min"}
                    type="number"
                    min="0"
                    step="1"
                    required
                    value={min}
                  />
                </label>
                <label>
                  Maximum{" "}
                  <input
                    id={id + "-max"}
                    type="number"
                    min="0"
                    step="1"
                    required
                    value={max}
                  />
                </label>
              </fieldset>
            ))}
          </details>
          <p class="muted">
            The timer keeps running if you switch tabs. Leaving this page
            discards an unfinished drill.
          </p>
          <button type="submit">Start drill</button>
          <p id="setup-error" class="error" role="alert"></p>
        </form>
      </section>
      <section id="drill" hidden aria-labelledby="drill-title">
        <div class="drill-bar">
          <span>
            Time left <strong id="timer">0:00</strong>
          </span>
          <span>
            Correct <strong id="score">0</strong>
          </span>
        </div>
        <h2 id="drill-title">
          What is{" "}
          <span id="question" aria-live="polite" aria-atomic="true">
            …
          </span>
          ?
        </h2>
        <form id="answer-form">
          <label>
            Your answer{" "}
            <input
              id="answer"
              inputmode="decimal"
              autocomplete="off"
              spellcheck="false"
            />
          </label>
          <div class="actions">
            <button id="submit-answer" type="submit">
              Submit answer
            </button>
            <button
              id="negate-answer"
              type="button"
              class="secondary"
              aria-label="Toggle answer sign"
            >
              +/−
            </button>
          </div>
        </form>
        <p id="drill-status" role="status"></p>
      </section>
      <section id="results" hidden aria-labelledby="results-title">
        <h2 id="results-title" tabindex="-1">
          Drill complete
        </h2>
        <p id="results-summary"></p>
        <p id="save-status" role="status"></p>
        <div class="actions">
          <button id="restart" type="button">
            Start another drill
          </button>
          <button id="download-session" type="button" hidden class="secondary">
            Download unsaved session
          </button>
        </div>
      </section>
      <section id="analytics" aria-labelledby="analytics-title">
        <h2 id="analytics-title">Your insights</h2>
        <label>
          View history{" "}
          <select id="analytics-session">
            <option value="">All sessions</option>
          </select>
        </label>
        <p id="analytics-empty" class="muted"></p>
        <div id="analytics-content" hidden>
          <h3>Session summary</h3>
          <div class="metric-grid" id="summary-metrics"></div>
          <p class="muted">
            Speed is the average of each session's questions per configured
            minute. Sessions with no answers are excluded; zero-duration
            sessions have no speed estimate.
          </p>
          <p id="sample-note" class="notice"></p>
          <p class="table-hint muted">
            On a small screen, scroll tables sideways to see every column.
          </p>
          <article>
            <h3>Digit difficulty</h3>
            <p class="muted">
              Answers with either operand containing each digit, sorted by
              response time.
            </p>
            <div
              id="digit-view"
              class="table-scroll"
              role="region"
              aria-label="Digit difficulty table"
              tabindex="0"
            ></div>
          </article>
          <article>
            <h3>Average response time</h3>
            <div
              id="operation-view"
              class="table-scroll"
              role="region"
              aria-label="Operation timing table"
              tabindex="0"
            ></div>
          </article>
          <article>
            <h3>Response sequence</h3>
            <p class="muted">
              Every answer in timestamp order. The rolling average uses up to
              five answers, including the current answer.
            </p>
            <div
              id="sequence-view"
              class="table-scroll sequence"
              role="region"
              aria-label="Response sequence table"
              tabindex="0"
            ></div>
          </article>
        </div>
        <p id="analytics-error" class="error" role="alert"></p>
      </section>
      <section id="history-tools" aria-labelledby="history-title">
        <h2 id="history-title">Your history, backed up</h2>
        <p class="muted">
          Export a JSON backup whenever you like. Clearing browser data removes
          your local history.
        </p>
        <button id="export-history" type="button" class="secondary">
          Export all history as JSON
        </button>
        <details>
          <summary>Import a backup or old desktop history</summary>
          <p class="muted">
            Each import appends every session. Importing the same file again
            adds duplicates. Export a backup before importing.
          </p>
          <label>
            JSON file{" "}
            <input
              id="import-file"
              type="file"
              accept="application/json,.json"
            />
          </label>
        </details>
        <p id="import-status" role="status" aria-live="polite"></p>
      </section>
      <footer>Built for focused practice. No account required.</footer>
    </main>
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
